---
import BaseLayout from '../layouts/BaseLayout.astro'
---

<BaseLayout title="Página no encontrada - Internship Tracker">
  <script is:inline>
    if (localStorage.getItem('auth_token')) {
      window.location.replace('/dashboard')
    } else {
      window.location.replace('/login')
    }
  </script>
  <div class="min-h-screen flex items-center justify-center px-4">
    <div class="text-center space-y-8">
      <div class="space-y-4">
        <h1 class="text-7xl font-semibold tracking-tight">
          <span class="text-accent">404</span>
        </h1>
        <p class="text-text-secondary text-lg max-w-md mx-auto">
          La página que buscas no existe o fue movida.
        </p>
      </div>

      <div class="flex items-center justify-center gap-4">
        <a
          href="/login"
          class="bg-surface border border-border hover:border-border-strong text-text px-6 py-3 rounded-md text-sm font-medium transition-colors duration-150"
        >
          Ir al inicio
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
